.container {
  padding: 24rpx;
}
.header {
  padding: 24rpx 8rpx 32rpx;
}
.title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
}
.subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #888;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.card-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.btn {
  border: none;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  margin: 0;
}
.btn + .btn {
  margin-top: 20rpx;
}
.btn-primary {
  background: #07c160;
  color: #fff;
}
.btn-upload {
  background: #1989fa;
  color: #fff;
}
.btn-ghost {
  background: #f2f3f5;
  color: #333;
}
.btn[disabled] {
  opacity: 0.6;
}
.file-info {
  margin: 24rpx 0;
  border-top: 1rpx solid #eee;
  padding-top: 16rpx;
}
.file-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  padding: 8rpx 0;
}
.file-row .label {
  color: #999;
}
.file-row .value {
  color: #333;
  max-width: 70%;
  text-align: right;
  word-break: break-all;
}
.file-row .value.code {
  font-size: 22rpx;
  color: #1989fa;
}
.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.list-item:last-child {
  border-bottom: none;
}
.list-main {
  display: flex;
  flex-direction: column;
}
.list-name {
  font-size: 28rpx;
}
.list-meta {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.list-arrow {
  color: #ccc;
  font-size: 36rpx;
}
